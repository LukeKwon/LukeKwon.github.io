---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { site, href } from '../lib/site';
const { title = site.name, description = site.description, active = '', article = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f5ef" />
    <title>{title === site.name ? `${site.name} | 생체역학 · 재활 · 움직임` : `${title} | ${site.name}`}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {Astro.site && <meta property="og:image" content={new URL(href('images/cover.png'), Astro.site)} />}
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 이동</a>
    <header class="site-header wrap">
      <a class="wordmark" href={href()} aria-label="Kinesiology Notes 홈"><span class="brand-dot"></span><span>KINESIOLOGY <strong>NOTES</strong></span></a>
      <nav aria-label="주 메뉴">
        <a class:list={{ active: active === 'posts' }} aria-current={active === 'posts' ? 'page' : undefined} href={href('#notes')}>글 목록</a>
        <a class:list={{ active: active === 'categories' }} aria-current={active === 'categories' ? 'page' : undefined} href={href('categories/')}>카테고리</a>
        <a class:list={{ active: active === 'about' }} aria-current={active === 'about' ? 'page' : undefined} href={href('about/')}>소개</a>
        <a class="nav-search" href={href('search/')} aria-label="글 검색"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><span>검색</span></a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap"><div><strong>KINESIOLOGY NOTES<span class="orange">.</span></strong><p>Biomechanics / Rehabilitation / Movement</p></div><div class="footer-right"><a href={site.naver} target="_blank" rel="noopener noreferrer">네이버 블로그 ↗</a><span>© {new Date().getFullYear()} {site.author}</span></div></footer>
  </body>
</html>
