---
import Layout from '../layouts/Layout.astro';
import { site, categories, href } from '../lib/site';
---
<Layout title="소개" active="about"><div class="wrap inner-page about-page"><div class="about-main"><p class="eyebrow">ABOUT KINESIOLOGY NOTES</p><h1>{site.name}<span class="orange">.</span></h1><p class="about-english">Biomechanics / Rehabilitation / Movement</p><p class="about-description">{site.description}</p><h2>기록하는 주제</h2><div class="about-topics">{categories.map(category => <a href={href(`categories/${category.slug}/`)}><strong>{category.name}</strong><span>{category.description}</span><span aria-hidden="true">→</span></a>)}</div><h2>작성자</h2><p>{site.author}</p><a class="text-link" href={site.naver} target="_blank" rel="noopener noreferrer">기존 네이버 블로그 ↗</a></div><img class="about-logo" src={href('images/logo.png')} width="360" height="360" alt="Kinesiology Notes 로고" /></div></Layout>
