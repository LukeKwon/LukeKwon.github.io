---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import { allCategories, href, postInCategory } from '../../lib/site';
import { getPosts } from '../../lib/posts';
export function getStaticPaths() { return allCategories.map(category => ({ params: { category: category.slug }, props: { category } })); }
const { category } = Astro.props;
const posts = (await getPosts()).filter(post => postInCategory(post, category));
---
<Layout title={category.name} active="categories"><div class="wrap inner-page readable-list"><a class="back-link" href={href('categories/')}>← 전체 카테고리</a><p class="eyebrow">{category.english}</p><h1>{category.name}<span class="orange">.</span></h1><p class="page-lead">{category.description}</p><PostList posts={posts} />{!posts.length && <div class="category-empty"><p>이 카테고리에는 아직 공개된 글이 없습니다.</p></div>}</div></Layout>
