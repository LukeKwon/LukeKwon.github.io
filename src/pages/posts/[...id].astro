---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { href, formatDate } from '../../lib/site';
export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const used = new Set<string>();
  return posts.flatMap(post => [post.data.slug!, ...post.data.legacySlugs].map(slug => {
    if (used.has(slug)) throw new Error(`Duplicate post address: ${slug}`);
    used.add(slug);
    return { params: { id: slug }, props: { post, redirectTo: slug === post.data.slug ? null : href(`posts/${post.data.slug}/`) } };
  }));
}
const { post, redirectTo } = Astro.props;
const { Content, headings } = redirectTo ? { Content: null, headings: [] } : await render(post);
const toc = headings.filter(heading => heading.depth === 2 || heading.depth === 3);
---
{redirectTo ? <html lang="ko"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{post.data.title}</title><link rel="canonical" href={new URL(redirectTo, Astro.site || Astro.url.origin)} /><meta name="robots" content="noindex,follow" /><meta http-equiv="refresh" content={`0;url=${redirectTo}`} /></head><body><p><a href={redirectTo}>새 글 주소로 이동</a></p><script is:inline define:vars={{ target: redirectTo }}>location.replace(target + location.search + location.hash);</script></body></html> : <Layout title={post.data.title} description={post.data.description} article><div class="wrap inner-page article-page"><div class="article-main"><a class="back-link" href={href('#notes')}>← 글 목록</a><p class="eyebrow">{post.data.category}</p><h1>{post.data.title}</h1><div class="article-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span>Junhyeong Kwon</span></div><div class="prose">{Content && <Content />}</div><div class="article-tags tags">{post.data.tags.map((tag: string) => <a href={href(`search/?q=${encodeURIComponent(tag)}`)}>#{tag}</a>)}</div></div>{toc.length > 0 && <aside class="toc"><h2>이 글의 목차</h2><ol>{toc.map(heading => <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></aside>}</div></Layout>}
